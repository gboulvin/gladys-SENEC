{
  "manifest_version": 1,
  "type": "device",
  "name": "SENEC.Home",
  "description": {
    "en": "SENEC.Home batteries and wallboxes on your local network: monitoring and control.",
    "fr": "Batteries et wallbox SENEC.Home sur votre réseau local : suivi et pilotage.",
    "de": "SENEC.Home-Speicher und Wallboxen im lokalen Netz: Überwachung und Steuerung.",
    "es": "Baterías y wallbox SENEC.Home en su red local: supervisión y control."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/gboulvin/gladys-senec:1.0.1",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/gboulvin/gladys-senec/main/cover.png",
  "categories": ["energy"],
  "keywords": [
    "SENEC",
    "SENEC.Home",
    "SENEC.Wallbox",
    "V3 hybrid",
    "battery",
    "batterie",
    "Stromspeicher",
    "batería",
    "wallbox",
    "solar"
  ],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Before you start",
        "fr": "Avant de commencer",
        "de": "Bevor Sie beginnen",
        "es": "Antes de empezar"
      },
      "description": {
        "en": "The integration reads and controls your SENEC.Home V2.1 or V3 on the local network, through the same local API as its web interface (lala.cgi), without any cloud account. Give the system a fixed IP address in your router, then enter that address below. SENEC.Home 4 / P4 systems have no local API and are not supported.",
        "fr": "L'intégration lit et pilote votre SENEC.Home V2.1 ou V3 sur le réseau local, via la même API locale que son interface web (lala.cgi), sans aucun compte cloud. Donnez au système une adresse IP fixe dans votre box, puis saisissez cette adresse ci-dessous. Les systèmes SENEC.Home 4 / P4 n'ont pas d'API locale et ne sont pas pris en charge.",
        "de": "Die Integration liest und steuert Ihr SENEC.Home V2.1 oder V3 im lokalen Netz, über dieselbe lokale Schnittstelle wie seine Weboberfläche (lala.cgi), ganz ohne Cloud-Konto. Vergeben Sie dem System in Ihrem Router eine feste IP-Adresse und tragen Sie diese unten ein. SENEC.Home 4 / P4 haben keine lokale Schnittstelle und werden nicht unterstützt.",
        "es": "La integración lee y controla su SENEC.Home V2.1 o V3 en la red local, mediante la misma API local que su interfaz web (lala.cgi), sin ninguna cuenta en la nube. Asigne al sistema una dirección IP fija en su router e introdúzcala a continuación. Los sistemas SENEC.Home 4 / P4 no tienen API local y no son compatibles."
      },
      "links": [
        {
          "url": "https://github.com/gboulvin/gladys-senec/blob/main/docs/en.md",
          "label": {
            "en": "Step-by-step guide",
            "fr": "Guide pas à pas",
            "de": "Schritt-für-Schritt-Anleitung",
            "es": "Guía paso a paso"
          }
        }
      ]
    },
    {
      "key": "hosts",
      "type": "string",
      "label": {
        "en": "SENEC.Home address",
        "fr": "Adresse du SENEC.Home",
        "de": "Adresse des SENEC.Home",
        "es": "Dirección del SENEC.Home"
      },
      "description": {
        "en": "IP address of your SENEC.Home (several systems: separate them with commas).",
        "fr": "Adresse IP de votre SENEC.Home (plusieurs systèmes : séparez-les par des virgules).",
        "de": "IP-Adresse Ihres SENEC.Home (mehrere Systeme: durch Kommas trennen).",
        "es": "Dirección IP de su SENEC.Home (varios sistemas: sepárelas con comas)."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.40",
        "fr": "ex. 192.168.1.40",
        "de": "z. B. 192.168.1.40",
        "es": "p. ej. 192.168.1.40"
      },
      "required": true
    },
    {
      "key": "protocol",
      "type": "select",
      "label": {
        "en": "Protocol",
        "fr": "Protocole",
        "de": "Protokoll",
        "es": "Protocolo"
      },
      "description": {
        "en": "HTTPS for the current firmware; HTTP only for an old firmware that does not answer in HTTPS.",
        "fr": "HTTPS pour les firmwares actuels ; HTTP seulement pour un ancien firmware qui ne répond pas en HTTPS.",
        "de": "HTTPS für aktuelle Firmware; HTTP nur für eine alte Firmware, die nicht per HTTPS antwortet.",
        "es": "HTTPS para el firmware actual; HTTP solo para un firmware antiguo que no responde por HTTPS."
      },
      "required": false,
      "default": "https",
      "options": [
        {
          "value": "https",
          "label": {
            "en": "HTTPS (recommended)",
            "fr": "HTTPS (recommandé)",
            "de": "HTTPS (empfohlen)",
            "es": "HTTPS (recomendado)"
          }
        },
        {
          "value": "http",
          "label": {
            "en": "HTTP (old firmware)",
            "fr": "HTTP (ancien firmware)",
            "de": "HTTP (alte Firmware)",
            "es": "HTTP (firmware antiguo)"
          }
        }
      ]
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)",
        "de": "Aktualisierungsintervall (s)",
        "es": "Intervalo de actualización (s)"
      },
      "description": {
        "en": "How often the system is read, in seconds.",
        "fr": "Fréquence de lecture du système, en secondes.",
        "de": "Wie oft das System gelesen wird, in Sekunden.",
        "es": "Frecuencia de lectura del sistema, en segundos."
      },
      "required": false,
      "default": 30,
      "min": 10,
      "max": 3600
    },
    {
      "key": "surplus_threshold",
      "type": "number",
      "label": {
        "en": "Solar surplus threshold (W)",
        "fr": "Seuil de surplus solaire (W)",
        "de": "Schwelle Solarüberschuss (W)",
        "es": "Umbral de excedente solar (W)"
      },
      "description": {
        "en": "Power fed into the grid above which the \"Solar surplus started\" scene trigger fires.",
        "fr": "Puissance injectée dans le réseau au-delà de laquelle le déclencheur « Début de surplus solaire » se déclenche.",
        "de": "Eingespeiste Leistung, ab der der Szenen-Auslöser „Solarüberschuss beginnt“ auslöst.",
        "es": "Potencia inyectada a la red a partir de la cual se activa el disparador «Comienza el excedente solar»."
      },
      "required": false,
      "default": 500,
      "min": 1,
      "max": 100000
    }
  ],
